  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run css & npm run eleventy",
    "eleventy": "eleventy --serve --quiet --incremental",
    "css": "postcss src/styles.css --output dist/styles.css --watch",
    "lint": "eslint 'dist/**/*.js'",
    "format": "prettier --write 'src/' 'dist/**/*.{js,html}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/html-vite": "^10.1.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.1.11",
    "globals": "^17.0.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-jinja-template": "^2.1.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.1.18",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "dompurify": "^3.3.3"
